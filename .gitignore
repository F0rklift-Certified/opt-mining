# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
.vscode/
.idea/
.kiro/
*.swp
*.swo

# Kiro
.kiro/

# Environment
.env
.env.*
# ...but keep committed `.env.example` templates (documentation, no secrets).
!.env.example
!**/.env.example

# Dependencies
node_modules/
__pycache__/
*.pyc

# Build
dist/
build/
*.egg-info/

# Logs
*.log

# Python virtual environment
.venv/

# Hypothesis: property-based test example database / cache, created when
# property-based tests run. Reproducible and machine-local; never committed.
.hypothesis/

# Raw data files (large ZIPs and CSVs)
Sprint-0-Tasks/Electricity Demand Data Investigation/raw/
Sprint-0-Tasks/Electricity Demand Data Investigation/*.csv

# Wind resource: full-country Global Wind Atlas rasters (~600 MB each, exceed
# GitHub's file limit). Committed samples are small clips; the full rasters are
# read over /vsicurl/ and never stored. See DATA/wind-resource/DATA_PROVENANCE.md
DATA/wind-resource/raw/
DATA/wind-resource/**/*_australia.tif

# Electricity demand: raw monthly AEMO ZIP archives (~nested zips of CSVs).
# Derived summaries are small and committed; raw downloads are reproducible.
DATA/electricity-demand/raw/

# Geographic: raw national archives (ABARES NLUM zip ~64 MB; any DEM tile
# downloads). Committed samples are small window clips and extracts; national
# rasters are read over /vsicurl/ or /vsizip/ from raw/ and never committed.
# See DATA/geographic/DATA_PROVENANCE.md
DATA/geographic/raw/
DATA/geographic/**/*_national.tif

# Geographic: full-NSW raster clips regenerated by
# scripts/fetch_build_geographic_nsw.py (SRTM GL3 DEM ~107 MB and its derived
# slope ~193 MB). These exceed the commit guardrail and are reproducible from
# the national sources on demand; only the small New England samples are
# committed. The full-NSW NLUM clip stays small but is regenerable too.
DATA/geographic/elevation/srtm-gl3_elevation_90m_nsw.tif
DATA/geographic/elevation/srtm-gl3_slope-horn_90m_nsw.tif
DATA/geographic/landuse/abares_nlum-alumv8_2020-21_nsw.tif

# Decision_Service (S2-08): per-Run materialisations. Each Run under
# DATA/service/runs/{run_id}/ is a regenerable re-materialisation of the S2-05
# Scored_Table under a given weights/scenario, content-addressed by run_id and
# recreated on demand from the frozen integrated table. Ephemeral runtime
# output, never custodial data. See pipeline/service/CONTRACT.md and runs.py.
DATA/service/runs/
