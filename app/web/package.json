{
  "name": "optmining-web",
  "version": "0.1.0",
  "private": true,
  "description": "Opt-Mining Next.js frontend — typed integration with the FastAPI decision service for the NSW MVP.",
  "scripts": {
    "test:e2e": "playwright test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "generate:api-schema": "python3 scripts/export-openapi.py",
    "generate:api-client": "npm run generate:api-schema && openapi-typescript openapi/decision-service.openapi.json --empty-objects-unknown -o app/api/generated.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "openapi-fetch": "0.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "openapi-typescript": "7.9.1",
    "typescript": "5.5.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
