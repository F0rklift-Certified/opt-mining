  "info": {
    "description": "The frozen S2-08 Decision_Service exposed over HTTP + OpenAPI. Eight operations, one per endpoint; the API delegates to the pure `pipeline.service` operations and holds no decision logic (CONTRACT.md \u00a71, \u00a72).",
    "title": "Opt-Mining Decision_Service",
    "version": "1.2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/data-quality": {
      "get": {
        "description": "`get_data_quality` \u2014 the frozen dataset's S2-02 Data_Quality_Status.",
        "operationId": "read_data_quality_data_quality_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataQualityStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Data Quality"
      }
    },
    "/runs": {
      "post": {
        "description": "`run_analysis` \u2014 materialise a Run under the given weights or scenario.\n\nPasses `weights` / `scenario` straight to the operation; the engine parser\nis the single validator (CONTRACT.md \u00a73, \u00a75). No one-of check or weight\ninterpretation is done here.",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunHandle"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Run"
      }
    },
    "/runs/{run_id}/cells": {
      "get": {
        "description": "`get_run_cells` \u2014 the Run's cells as a GeoJSON FeatureCollection.\n\n`run_id` is passed straight through; the operation projects the Scored_Table\ninto one Point Feature per cell, carrying each centroid in EPSG:4326\nverbatim. It reuses the centralised `_STATUS_FOR_FAULT` map (missing Run ->\n404, missing/unreadable output or missing centroid column -> 503), so no\nmapping change is needed. This layer never reprojects or re-scores.",
        "operationId": "read_run_cells_runs__run_id__cells_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
