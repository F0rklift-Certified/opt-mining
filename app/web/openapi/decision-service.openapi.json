{
  "components": {
    "schemas": {
      "CellCollection": {
        "description": "A Run's cells as a GeoJSON FeatureCollection (CONTRACT.md \u00a75, \u00a74.7).\n\nOne Point Feature per Scored_Table cell (eligible and excluded alike),\ncarrying each cell's EPSG:4326 centroid verbatim. The set of `eligible`\nFeatures equals the set `get_ranked_results` returns for the Run (\u00a77 P1).",
        "properties": {
          "features": {
            "items": {
              "$ref": "#/components/schemas/CellFeature"
            },
            "title": "Features",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "score_quantiles": {
            "items": {
              "$ref": "#/components/schemas/ScoreQuantile"
            },
            "title": "Score Quantiles",
            "type": "array"
          },
          "type": {
            "const": "FeatureCollection",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "run_id"
        ],
        "title": "CellCollection",
        "type": "object"
      },
      "CellFeature": {
        "description": "One analysis cell as a GeoJSON Point Feature (CONTRACT.md \u00a75, \u00a74.7).",
        "properties": {
          "geometry": {
            "$ref": "#/components/schemas/CellGeometry"
          },
          "properties": {
            "$ref": "#/components/schemas/CellProperties"
          },
          "type": {
            "const": "Feature",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "geometry",
          "properties"
        ],
        "title": "CellFeature",
        "type": "object"
      },
      "CellGeometry": {
        "description": "A cell centroid's GeoJSON Point geometry (CONTRACT.md \u00a75, \u00a74.7).\n\n`coordinates` are ``[centroid_lon, centroid_lat]`` in EPSG:4326, carried\nthrough verbatim from the Scored_Table \u2014 no reprojection (CONTRACT.md \u00a71).",
        "properties": {
          "coordinates": {
            "items": {
              "type": "number"
            },
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordinates",
            "type": "array"
          },
          "type": {
            "const": "Point",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "coordinates"
        ],
        "title": "CellGeometry",
        "type": "object"
      },
      "CellProperties": {
        "description": "A map cell's non-geometric properties (CONTRACT.md \u00a75, \u00a74.7).\n\n`eligible` is the same predicate `get_ranked_results` uses (score AND rank\nboth non-null); `suitability_score` / `rank` are null for an excluded cell.",
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "eligible": {
            "title": "Eligible",
            "type": "boolean"
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank"
          },
          "suitability_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suitability Score"
          }
        },
        "required": [
          "cell_id",
          "eligible"
        ],
        "title": "CellProperties",
        "type": "object"
      },
      "Criterion": {
        "description": "One scored criterion inside a `Weights` configuration (CONTRACT.md \u00a75).\n\nMirrors the `scoring_weights.yaml` / scenario `criteria` entry so it is\nvalidated by the SAME engine parser (`pipeline/scoring/weights.py`), never a\nduplicate validator \u2014 hence no field constraints (e.g. weight >= 0, the\ndirection enum) are re-declared here.",
        "properties": {
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "feature": {
            "title": "Feature",
            "type": "string"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "feature",
          "weight",
          "direction",
          "rationale"
        ],
        "title": "Criterion",
        "type": "object"
      },
      "DataQualityCheck": {
        "description": "One data-quality check record (CONTRACT.md \u00a75, S2-02 shape).",
        "properties": {
          "expected": {
            "title": "Expected",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed": {
            "title": "Observed",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "expected",
          "observed",
          "passed"
        ],
        "title": "DataQualityCheck",
        "type": "object"
      },
      "DataQualityStatus": {
        "description": "The S2-02 Data_Quality_Status for the frozen integrated dataset (CONTRACT.md \u00a75).",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/DataQualityCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "passed": {
            "default": false,
            "title": "Passed",
            "type": "boolean"
          }
        },
        "title": "DataQualityStatus",
        "type": "object"
      },
      "ExcludedRow": {
        "description": "One excluded cell's eligibility reason(s) for a Run (CONTRACT.md \u00a75).",
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "reason_codes": {
            "items": {
              "type": "string"
            },
            "title": "Reason Codes",
            "type": "array"
          },
          "reason_text": {
            "default": "",
            "title": "Reason Text",
            "type": "string"
          }
        },
        "required": [
          "cell_id"
        ],
        "title": "ExcludedRow",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "RankedRow": {
        "description": "One eligible cell's ranked result for a Run (CONTRACT.md \u00a75).",
        "properties": {
          "cell_id": {
            "title": "Cell Id",
            "type": "string"
          },
          "key_components": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Key Components",
            "type": "object"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "suitability_score": {
            "title": "Suitability Score",
            "type": "number"
          }
        },
        "required": [
          "cell_id",
          "suitability_score",
          "rank"
        ],
        "title": "RankedRow",
        "type": "object"
      },
      "RunHandle": {
        "description": "Identifies one materialised Run (CONTRACT.md \u00a75).",
        "properties": {
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "weights_id": {
            "title": "Weights Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "weights_id"
        ],
        "title": "RunHandle",
        "type": "object"
      },
      "RunRequest": {
        "description": "Request body for `run_analysis` \u2014 `POST /runs` (CONTRACT.md \u00a74.1, \u00a75).\n\nExactly one of `weights` / `scenario` must be given; that one-of rule is\nenforced by the `run_analysis` operation (which returns 422 on a fault),\nnot by this model, so both fields are nullable here. The backend does NOT\nvalidate weights itself \u2014 it passes them to the engine parser.",
        "properties": {
          "scenario": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario"
          },
          "weights": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Weights"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "RunRequest",
        "type": "object"
      },
      "SanityCheck": {
        "description": "The S1-12 sanity-check / validation result (CONTRACT.md \u00a75, \u00a74.8, S3-08).\n\nMirrors `pipeline/service/models.py::SanityCheck` field-for-field: the\nalways-on model-not-trained `caveat`, the `preliminary_disclaimer`, the\nlineage `run_metadata`, the normalised per-check `checks` (incl. the\nsynthesized exclusion summary), the full `contradictions` list, the\nknown-wind-farm `wind_farms` table, the top-ranked band `top_band_n`, and the\nper-landmark `exclusion_assertions` \u2014 all carried verbatim. `exclusion_assertions`\nis a free-form mapping list so the mirror neither renames nor reorders the\nsanity stage's assertion fields.",
        "properties": {
          "caveat": {
            "default": "",
            "title": "Caveat",
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/SanityCheckItem"
            },
            "title": "Checks",
            "type": "array"
          },
          "contradictions": {
            "items": {
              "$ref": "#/components/schemas/SanityContradiction"
            },
            "title": "Contradictions",
            "type": "array"
          },
          "exclusion_assertions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Exclusion Assertions",
            "type": "array"
          },
          "preliminary_disclaimer": {
            "default": "",
            "title": "Preliminary Disclaimer",
            "type": "string"
          },
          "run_metadata": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SanityRunMetadata"
              },
              {
                "type": "null"
              }
            ]
          },
          "top_band_n": {
            "default": 0,
            "title": "Top Band N",
            "type": "integer"
          },
          "wind_farms": {
            "items": {
              "$ref": "#/components/schemas/SanityWindFarmRow"
            },
            "title": "Wind Farms",
            "type": "array"
          }
        },
        "title": "SanityCheck",
        "type": "object"
      },
      "SanityCheckItem": {
        "description": "One normalised sanity-check outcome (CONTRACT.md \u00a75, \u00a74.8, S3-08).",
        "properties": {
          "expected": {
            "title": "Expected",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "observed": {
            "title": "Observed",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "expected",
          "observed",
          "passed"
        ],
        "title": "SanityCheckItem",
        "type": "object"
      },
      "SanityContradiction": {
        "description": "One documented sanity contradiction / issue (CONTRACT.md \u00a75, \u00a74.8).",
        "properties": {
          "check": {
            "title": "Check",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "investigation_note": {
            "title": "Investigation Note",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "check",
          "description",
          "kind",
          "investigation_note"
        ],
        "title": "SanityContradiction",
        "type": "object"
      },
