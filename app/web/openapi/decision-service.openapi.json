          "cell_id"
        ],
        "title": "SanityWindFarmRow",
        "type": "object"
      },
      "ScenarioComparison": {
        "description": "A per-cell ranking comparison between two scenarios (CONTRACT.md \u00a75).",
        "properties": {
          "labels": {
            "additionalProperties": {
              "type": "string"
            },
