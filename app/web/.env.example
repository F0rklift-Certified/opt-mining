# Frontend_App environment (S3-01b — decision-service integration)
#
# Copy this file to `.env.local` (Next.js loads it automatically for `next dev`
# and `next build`) and adjust the value for your environment.
#
# The shared typed client reads the backend Service_URL only from this variable.
# No host address is hard-coded in application source.

# Browser-reachable base URL of the Backend_App (FastAPI).
# Any `NEXT_PUBLIC_*` variable is exposed to the browser by Next.js.
#   - dev (example):     http://localhost:8000
#   - compose (example): http://localhost:8000   (the published API host port)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
