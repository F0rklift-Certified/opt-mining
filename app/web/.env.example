# Frontend_App environment (S3-01b — decision-service integration)
#
# Copy this file to `.env.local` (Next.js loads it automatically for `next dev`
# and `next build`) and adjust the value for your environment.
#
# The shared typed client reads the backend Service_URL only from this variable.
# No host address is hard-coded in application source.

# Browser-reachable base URL of the Backend_App (FastAPI).
# Any `NEXT_PUBLIC_*` variable is exposed to the browser by Next.js.
#   - dev (example):     http://localhost:8000
#   - compose (example): http://localhost:8000   (the published API host port)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Browser-reachable XYZ raster tile URL for the interactive-map basemap (S3-03a).
# This is map *context* only — the decision content is the cell layer served by
# the API. The default below is the public OpenStreetMap standard raster tiles,
# which are MVP/dev-only: OSM's tile usage policy restricts bulk/app use, so any
# deployed or non-trivial deployment MUST override this with a self-hosted or
# licensed tile endpoint. The map still renders the cell layer over an empty
# background if the basemap is unreachable, so this is non-blocking.
NEXT_PUBLIC_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
