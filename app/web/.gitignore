# Next.js build / dev output and generated types (regenerated by `next dev` /
# `next build`; never committed). Keeps the documented dev-startup integration
# test (tests/backend/test_documented_dev_startup_integration.py) and any manual
# run from leaving generated files tracked.
/.next/
/out/
next-env.d.ts

# Node dependencies (installed via `npm install`).
/node_modules/

# Local env files (NEXT_PUBLIC_API_BASE_URL etc.); .env.example is committed.
.env
.env.local
.env.*.local
